# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=0
AUTH_MODE=development

# Firebase production configuration. Do not invent values; copy these from the
# Firebase Console after registering the ADS web app and enabling Email/Password.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Configure Google Application Default Credentials on the server. Never commit
# a service-account key or place one in browser-visible configuration.

# Database Configuration
DATABASE_URL=sqlite:///aml_database.db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=aml_system.log

# Model Configuration
MODELS_FOLDER=models
IBM_AML_SOURCE=
IBM_AML_DB=data/ibm_hi_small.sqlite3
IBM_AML_MODEL=models/ibm_hi_small_sgd.joblib
IBM_AML_METRICS=reports/ibm_hi_small_metrics.json

# Risk Thresholds
RISK_THRESHOLD_SAFE=0.2
RISK_THRESHOLD_LOW=0.4
RISK_THRESHOLD_MEDIUM=0.6
RISK_THRESHOLD_HIGH=0.8
RISK_THRESHOLD_CRITICAL=1.0
